{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/AntIcon/**",
              "components/Button/**",
              "components/DataTable/**",
              "components/PageHeader/**",
              "components/SiderMenu/**",
              "components/StatCard/**",
              "components/StatusBadge/**",
              "components/Tag/**",
              "ui_kits/admin-console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Alibaba Sans))/i]",
        "message": "Font not provided by the design system. Available: Alibaba Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|className|spin|key|ref|className|style|children)$/]",
        "message": "<AntIcon> doesn't accept that prop. Declared props: name, size, color, style, className, spin."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|size|block|danger|disabled|icon|children|onClick|htmlType|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: type, size, block, danger, disabled, icon, children, onClick, htmlType, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:primary|default|dashed|text|link)$/]",
        "message": "<Button> type must be one of 'primary' | 'default' | 'dashed' | 'text' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|large)$/]",
        "message": "<Button> size must be one of 'small' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='htmlType'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> htmlType must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|key|dataIndex|render|secondary|width|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: title, key, dataIndex, render, secondary, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:crumbs|title|extra|style|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: crumbs, title, extra, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiderMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|children|key|ref|className|style|children)$/]",
        "message": "<SiderMenuItem> doesn't accept that prop. Declared props: key, label, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|total|footer|hint|children|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: title, total, footer, hint, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|text|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:Default|Processing|Success|Error|Warning)$/]",
        "message": "<StatusBadge> status must be one of 'Default' | 'Processing' | 'Success' | 'Error' | 'Warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: color, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|processing|success|warning|error|default)$/]",
        "message": "<Tag> color must be one of 'blue' | 'processing' | 'success' | 'warning' | 'error' | 'default'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
